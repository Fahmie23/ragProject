+.rag-production-retrieval-row > span:nth-child(3) strong, .rag-production-retrieval-row small { display: block; }
+.rag-production-retrieval-row > span:nth-child(3) strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.rag-production-retrieval-row small { margin-top: 2px; color: #949ba5; font-size: 8px; font-weight: 500; }
+.rag-production-retrieval-row .rag-used-badge, .rag-production-retrieval-row .rag-available-badge { justify-self: start; }
+.rag-inspector-footnote { margin: 0; color: #7d8690; font-size: 9px; line-height: 1.5; }
+
+@media (max-width: 900px) {
+  .rag-retrieval-stage-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .rag-retrieval-trace-note { align-items: flex-start; flex-direction: column; gap: 4px; }
+}
