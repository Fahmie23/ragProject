+    return {
+        "contract_version": "stage14_playground_contract_v1",
+        "live_query": {
+            "endpoint": "/api/generation/answer",
+            "method": "POST",
+            "may_call_external_generation_provider": True,
+            "production_profile_only": True,
+            "request_configurable_retrieval": False,
+        },
+        "field_origins": [
+            {
+                "area": "answer",
