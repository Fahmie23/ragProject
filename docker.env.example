# Stage 13 local Docker defaults. Copy to .env only if you want overrides.
# Do not commit real secrets.

POSTGRES_DB=rag_workbench
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# The browser reaches the published backend port on the host.
# Leave empty for Docker same-origin nginx proxying to the backend service.
VITE_API_BASE=

# Match the model profile verified in Stages 6-11.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=2
RERANKER_MAX_LENGTH=1024

# Stage 9/10 verified generation profile. Keep the API key outside Git.
GENERATION_PROVIDER=groq
GENERATION_BASE_URL=https://api.groq.com/openai/v1
GENERATION_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GENERATION_TIMEOUT_SECONDS=90
GENERATION_TEMPERATURE=0
GENERATION_MAX_TOKENS=1200
GENERATION_JSON_MODE=true
GENERATION_MAX_CONTEXT_CHARS=40000
