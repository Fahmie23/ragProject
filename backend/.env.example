DATA_DIR=data
MAX_UPLOAD_MB=50

# PostgreSQL + pgvector. Leave DATABASE_URL unset to run the deterministic
# extraction/chunking pipeline without persistence (useful for isolated tests).
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_workbench
DATABASE_REQUIRED=true

# Stage 6 dense embeddings. BGE-M3 provides long-context dense embeddings while
# keeping Stage 5 semantic boundaries intact. The model is downloaded on first use.
EMBEDDING_MODEL=BAAI/bge-m3

# Device options:
#   auto   -> CUDA when available, otherwise CPU
#   cpu    -> always CPU
#   cuda   -> require the default CUDA GPU (fail clearly if unavailable)
#   cuda:0 -> require a specific CUDA GPU index
EMBEDDING_DEVICE=auto

# BGE-M3 is substantially larger than the earlier small baseline; 8 is a conservative default.
# Increase this after measuring your CPU/GPU memory headroom.
EMBEDDING_BATCH_SIZE=8

# Stage 8 cross-encoder reranking. The BGE reranker is loaded lazily on first
# Hybrid + Reranker request and cached for later requests in the same process.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=2
# The model can represent longer inputs, but its maintainers recommend 1024
# for reranking. Stage 8 checks exact pair token counts before inference and
# refuses silent truncation.
RERANKER_MAX_LENGTH=1024


# Stage 9 grounded answer generation. The default client uses Groq's
# OpenAI-compatible chat-completions API. Keep keys only in .env; never commit them.
GENERATION_PROVIDER=groq
GENERATION_BASE_URL=https://api.groq.com/openai/v1
GENERATION_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# GENERATION_API_KEY=   # optional generic override for another compatible provider
GENERATION_TIMEOUT_SECONDS=90
GENERATION_TEMPERATURE=0
GENERATION_MAX_TOKENS=1200
GENERATION_JSON_MODE=true
# Guard only: Stage 9 refuses oversized prompts instead of silently truncating evidence.
GENERATION_MAX_CONTEXT_CHARS=40000

# Optional: authenticated Hugging Face downloads/rate limits
HF_TOKEN=
